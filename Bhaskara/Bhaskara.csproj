<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationTitle>Calculadora de Bhaskara</ApplicationTitle>
    <ApplicationId>br.edu.tde01.bhaskara</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" ForegroundFile="Resources/AppIcon/bhaskara_icon.png" Color="#F1F5F9" />
